# --- Embeddings ---
# sentence-transformers (réel) | hashing (hors ligne, pour tests/démo sans téléchargement)
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# --- Découpage ---
CHUNK_MAX_WORDS=220
CHUNK_OVERLAP_WORDS=40

# --- Recherche ---
TOP_K=5
CANDIDATES=20
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- Détection des réponses absentes (voir README) ---
# MIN_SIMILARITY : vide = valeur par défaut selon le modèle d'embedding ; MIN_COVERAGE entre 0 et 1
# MIN_SIMILARITY=0.78
MIN_COVERAGE=0.34

# --- LLM ---
# anthropic | ollama | none (mode extractif : renvoie les passages sans génération)
LLM_PROVIDER=ollama
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# --- UI ---
API_URL=http://localhost:8000
